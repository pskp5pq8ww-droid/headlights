# ─────────────────────────────────────────────────────────────────────────────
# Shining Headlights Australia — environment reference (Hostinger)
# ─────────────────────────────────────────────────────────────────────────────
# This PHP project reads configuration in this order:
#   1) Real environment variables (Hostinger hPanel → Advanced → Environment vars)
#   2) Private PHP config files OUTSIDE public_html (recommended on shared hosting):
#        /home/u613502604/_private/square.php   (Square — see _private/square.example.php)
#        /home/u613502604/_private/admin.php    (admin login)
#        /home/u613502604/_private/maps.php      (Google Maps key)
#
# Copy this file to .env for local reference. On Hostinger shared hosting a plain
# .env is NOT auto-loaded by PHP, so prefer the _private/*.php files OR set the
# variables below as real environment variables in hPanel.
# NEVER commit real secrets — .env and _private/*.php are gitignored.

# ── Square payments ──────────────────────────────────────────────────────────
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=PRODUCTION_APPLICATION_ID
SQUARE_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
SQUARE_LOCATION_ID=PRODUCTION_LOCATION_ID
SQUARE_CURRENCY=AUD

# ── Storage (optional — defaults to <project>/Storagehighlights) ─────────────
# Base folder that holds /bookings, /payments, /logs, /booking-uploads, /backups
BOOKING_STORAGE_PATH=/home/u613502604/domains/shiningaus.com/storage
# Optional explicit overrides (otherwise derived from BOOKING_STORAGE_PATH):
PAYMENTS_STORAGE_PATH=/home/u613502604/domains/shiningaus.com/storage/payments

# ── Admin login (or use /home/u613502604/_private/admin.php) ─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
ADMIN_EMAIL=hello@shiningaus.com

# ── Google Maps (or use /home/u613502604/_private/maps.php) ──────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY

# ── Public site URL ──────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://shiningaus.com
