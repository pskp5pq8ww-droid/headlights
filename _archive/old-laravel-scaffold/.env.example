APP_NAME="Shining Headlights Australia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shiningheadlights.com.au

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="hello@shiningheadlights.com.au"
MAIL_FROM_NAME="${APP_NAME}"
